msgid "plugins.generic.mailSendFilter.name"
msgstr "Elektron Pochta Filtrlash"

msgid "plugins.generic.mailSendFilter.description"
msgstr "Ushbu plagin elektron xatlarni muayyan foydalanuvchi hisoblariga yuborishni oldini oladi, qaytarilgan xatlarni kamaytiradi va serveringizning qora ro'yxatga olinishining oldini oladi."

msgid "plugins.generic.mailSendFilter.downloadEmails"
msgstr "Bloklangan xatlarni yuklab olish"

msgid "plugins.generic.mailSendFilter.general"
msgstr "Umumiy sozlamalar"

msgid "plugins.generic.mailSendFilter.checkInactivity"
msgstr "Oxirgi kirish sanasiga ko'ra faol bo'lmagan hisoblarni o'tkazib yuborish"

msgid "plugins.generic.mailSendFilter.checkMxRecord"
msgstr "Yaroqli MX yozuviga ega bo'lmagan domenlarni o'tkazib yuborish"

msgid "plugins.generic.mailSendFilter.checkDisposable"
msgstr "Bir martalik pochta xizmatlarini o'tkazib yuborish"

msgid "plugins.generic.mailSendFilter.checkNeverLoggedIn"
msgstr "Hech qachon kirmagan hisoblarni o'tkazib yuborish"

msgid "plugins.generic.mailSendFilter.checkNotValidated"
msgstr "Tasdiqlanmagan hisoblarni o'tkazib yuborish"

msgid "plugins.generic.mailSendFilter.disposableDomainsUrls"
msgstr "Bir martalik domenlar roʻyxatini yuklab olish uchun URL manzillarini sozlaydi, har satrda bitta URL. Har bir yuklab olingan roʻyxatda har satrda bitta element boʻlishi kerak; / bilan boshlanuvchi elementlar PCRE muntazam ifodalari sifatida qabul qilinadi (ajratgichlar va flaglar bilan birga).."

msgid "plugins.generic.mailSendFilter.disposableDomainsExpiration"
msgstr "Domenlarning amal qilish muddati (kun)"

msgid "plugins.generic.mailSendFilter.passthroughMailKeys"
msgstr "Tekshiruvlarni o'tkazib yuboradigan kalitlar"

msgid "plugins.generic.mailSendFilter.inactivity.threshold.days"
msgstr "X kundan eski hisoblarni tekshirish"

msgid "plugins.generic.mailSendFilter.inactivity.threshold.rules"
msgstr "Faol bo'lmaganlik qoidalari (kun)"

msgid "plugins.generic.mailSendFilter.inactivity.threshold.rules.help"
msgstr "<ul><li>Bo'sh = tekshirilmaydi</li><li>0 = hech qachon faol emas</li><li>Ko'p qoidalar = eng yumshoq qo'llaniladi</li></ul>"

msgid "user.role.none"
msgstr "Rolsiz hisoblar"

msgid "user.with.submission"
msgstr "Topshiriq bilan hisoblar"

msgid "plugins.generic.mailSendFilter.reason.disposableService"
msgstr "Bir martalik xizmat"

msgid "plugins.generic.mailSendFilter.reason.invalidMailExchange"
msgstr "Yaroqsiz MX yozuvi"

msgid "plugins.generic.mailSendFilter.reason.notValidated"
msgstr "Tasdiqlanmagan"

msgid "plugins.generic.mailSendFilter.reason.never_logged"
msgstr "Hech qachon kirmagan"

msgid "plugins.generic.mailSendFilter.reason.inactive"
msgstr "Faol bo'lmagan hisob"

msgid "plugins.generic.mailSendFilter.limitedActivation"
msgstr "Faqat administratorlar boshqarishi mumkin"

msgid "plugins.generic.mailSendFilter.failedDelivery"
msgstr "<a href=\"{$downloadUrl}\" target=\"_blank\">\"{$subject}\" xatini {$count} qabul qiluvchiga yetkazib bo'lmadi. Muvaffaqiyatsiz qabul qiluvchilar ro'yxatini yuklab oling</a>."

msgid "plugins.generic.mailSendFilter.failedDeliveryNotification"
msgstr "Xatni barcha qabul qiluvchilarga yetkazib bo'lmadi. Qo'shimcha tafsilotlar uchun bildirishnomalar ro'yxatini ko'ring."
